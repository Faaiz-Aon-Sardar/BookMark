{
  "name": "Bookmark Launcher",
  "short_name": "Launcher",
  "description": "Fast personal website launcher and bookmark organizer for desktop and mobile.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0F172A",
  "theme_color": "#4F46E5",
  "categories": ["utilities", "productivity"],
  "icons": [
    {
      "src": "/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "All Bookmarks",
      "short_name": "All",
      "description": "View all bookmarks",
      "url": "/?filter=all",
      "icons": [{ "src": "/icon-192.svg", "sizes": "192x192" }]
    },
    {
      "name": "Favorites",
      "short_name": "Favorites",
      "description": "View favorite bookmarks",
      "url": "/?filter=favorites",
      "icons": [{ "src": "/icon-192.svg", "sizes": "192x192" }]
    }
  ]
}
